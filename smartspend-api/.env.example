ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://0.0.0.0:8080
ConnectionStrings__Default=Data Source=/var/data/smartspend.db
Jwt__Key=replace-with-a-long-random-secret-at-least-32-chars
Cors__AllowedOrigins=https://your-smartspend.vercel.app
Vapid__Subject=mailto:admin@smartspend.app
Vapid__PublicKey=replace-with-your-vapid-public-key
Vapid__PrivateKey=replace-with-your-vapid-private-key
